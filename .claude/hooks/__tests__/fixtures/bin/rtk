#!/usr/bin/env bash
#
# Deterministic stub `rtk` for rtk-line-scan.test.sh. Real rtk is a locally-installed tool absent
# from CI (NA-89 QA finding) — this stub implements only the `hook check -- <line>` subcommand,
# returning the exact transforms this suite's assertions were verified against real rtk 0.42.0,
# so the suite exercises the hook's own guard/scan logic deterministically on any machine, with
# or without real rtk present.
set -u

if [ "${1:-}" != "hook" ] || [ "${2:-}" != "check" ] || [ "${3:-}" != "--" ]; then
  echo "stub-rtk: unsupported invocation: $*" >&2
  exit 2
fi
line="$4"

# Real rtk strips leading whitespace before matching (verified 2026-07-31); the hook re-applies
# the caller's indent to whatever this prints, so match/emit on the trimmed form only.
indent="${line%%[![:space:]]*}"
trimmed="${line#"$indent"}"

case "$trimmed" in
  "rtk "*)
    # Idempotent: rtk never re-wraps its own output.
    printf '%s' "$trimmed"
    exit 0
    ;;
esac

case "$trimmed" in
  "git status") printf 'rtk git status' ;;
  "git log --oneline -3") printf 'rtk git log --oneline -3' ;;
  "grep -n a b.md") printf 'rtk grep -n a b.md' ;;
  'git commit -m "line one') printf '%s' 'rtk git commit -m "line one' ;;
  "pnpm exec tsc --noEmit") printf 'rtk tsc --noEmit' ;;
  "cd /repo && pnpm exec tsc --noEmit") printf 'cd /repo && rtk tsc --noEmit' ;;
  "pnpm exec eslint .") printf 'rtk lint .' ;;
  "pnpm exec vitest run") printf 'rtk vitest' ;;
  "pnpm exec prettier --check a.md") printf 'rtk prettier --check a.md' ;;
  "git status && pnpm exec prettier --check a.md") printf 'rtk git status && rtk prettier --check a.md' ;;
  "npx nx test") printf 'rtk npx nx test' ;;
  *)
    echo "No rewrite for: $trimmed"
    exit 1
    ;;
esac
exit 0
